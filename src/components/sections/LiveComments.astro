---
import { getI18n } from '../../i18n';
import { getComentarios } from '../../lib/comentarios';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getI18n(lang);
const s = t.pages.comentarios;

// Si Supabase no está configurado o falla, esto devuelve [] y la sección
// simplemente no se pinta: la página nunca se rompe por eso.
const comentarios = await getComentarios(lang);

const fecha = (iso: string) =>
  new Date(iso).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

{comentarios.length > 0 && (
  <section class="bg-gray-50 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20">
      <p class="text-xs font-700 tracking-[0.2em] uppercase text-cnv-generate mb-4">{s.live_tag}</p>
      <h2 class="text-3xl md:text-4xl font-800 text-cnv-core max-w-3xl">{s.live_title}</h2>
      <p class="mt-4 text-sm text-cnv-core/50">
        {comentarios.length} {comentarios.length === 1 ? s.live_count_one : s.live_count_many}
      </p>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
        {comentarios.map((c) => (
          <figure class="flex flex-col rounded-2xl bg-white border border-gray-100 shadow-sm p-8">
            <div class="text-cnv-generate text-4xl leading-none mb-4" aria-hidden="true">&ldquo;</div>
            <blockquote class="flex-1 text-base leading-relaxed text-cnv-core/80 whitespace-pre-line">
              {c.comment}
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-4 border-t border-gray-100 pt-5">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full bg-cnv-core/5 text-sm font-800 text-cnv-core">
                {c.name.trim().split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase()}
              </div>
              <div>
                <p class="text-sm font-800 text-cnv-core">{c.name}</p>
                <p class="text-xs text-cnv-core/50">
                  {[c.role, c.location].filter(Boolean).join(' · ')}
                </p>
                <p class="text-xs text-cnv-core/30 mt-0.5">{fecha(c.created_at)}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
