---
import { getI18n, getRouteInOtherLang } from '../../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getI18n(lang);

const otherLang = lang === 'es' ? 'EN' : 'ES';
const otherLangHref = getRouteInOtherLang(Astro.url);

// Estructura del menú, espejo del mapa del sitio.
//
// Dos desplegables, ambos de una sola columna y un solo nivel:
//  - "Ecosistema empresarial": únicamente las cuatro unidades de negocio.
//    Lo que pertenece a cada unidad (OB-BIA LATAM en CNV Research, el LMS en
//    CNV Learning, ATLAS y ATLAS Patients en CNV DATA) vive DENTRO de la página
//    de esa unidad, no como subpestaña del menú.
//  - "Integrantes": la propia página más Contáctenos y Comentarios.
const ecosystemLinks = [
  { href: t.routes.care, label: t.nav.operacion },
  { href: t.routes.learning, label: t.nav.formacion },
  { href: t.routes.research, label: t.nav.investigacion },
  { href: t.routes.cnv_data, label: t.nav.cnv_data },
];

// Integrantes es el botón destacado del navbar y lleva Comentarios debajo:
// son los integrantes del modelo quienes dejan los comentarios.
// Contáctanos queda aparte, como enlace normal.
const membersLinks = [
  { href: t.routes.integrantes, label: t.nav.integrantes },
  { href: t.routes.comentarios, label: t.nav.comentarios },
];

const currentPath = Astro.url.pathname;

const matches = (href?: string) =>
  !!href && (currentPath === href || currentPath === href + '/');

const ecosystemActive = ecosystemLinks.some((l) => matches(l.href));
const membersActive = membersLinks.some((l) => matches(l.href));
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-transparent"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <nav class="flex items-center justify-between h-18 lg:h-20">

      <a href={t.routes.home} class="flex items-center gap-3 flex-shrink-0">
        <img
          src="/images/logo-horizontal-dark.svg"
          alt="Connected Nutrition Ventures"
          class="h-10 hidden dark-nav:block"
          id="logo-dark"
        />
        <img
          src="/images/logo-horizontal-light.svg"
          alt="Connected Nutrition Ventures"
          class="h-12 block"
          id="logo-light"
        />
      </a>

      <div class="hidden lg:flex items-center gap-7">

        <a
          href={t.routes.home}
          class={`text-sm font-600 tracking-wide transition-colors duration-200 nav-link ${
            matches(t.routes.home) ? 'text-cnv-execute' : 'text-cnv-core hover:text-cnv-execute'
          }`}
        >
          {t.nav.home}
        </a>

        <a
          href={t.routes.sitemap}
          class={`text-sm font-600 tracking-wide transition-colors duration-200 nav-link ${
            matches(t.routes.sitemap) ? 'text-cnv-execute' : 'text-cnv-core hover:text-cnv-execute'
          }`}
        >
          {t.footer.sitemap}
        </a>

        <!-- ECOSISTEMA EMPRESARIAL: sólo las cuatro unidades -->
        <div class="relative group">
          <button
            type="button"
            aria-haspopup="true"
            class={`text-sm font-600 tracking-wide transition-colors duration-200 nav-link flex items-center gap-1.5 ${
              ecosystemActive ? 'text-cnv-execute' : 'text-cnv-core hover:text-cnv-execute'
            }`}
          >
            {t.nav.ecosistema}
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform duration-200 group-hover:rotate-180">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-3 hidden group-hover:block focus-within:block">
            <div class="bg-white rounded-xl shadow-xl border border-slate-100/80 py-2 min-w-[210px]">
              {ecosystemLinks.map((link) => (
                <a
                  href={link.href}
                  class={`block px-5 py-2.5 text-sm font-600 tracking-wide transition-colors ${
                    matches(link.href)
                      ? 'text-cnv-execute'
                      : 'text-cnv-core hover:text-cnv-execute hover:bg-slate-50'
                  }`}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a
          href={t.routes.store}
          class={`text-sm font-600 tracking-wide transition-colors duration-200 nav-link ${
            matches(t.routes.store) ? 'text-cnv-execute' : 'text-cnv-core hover:text-cnv-execute'
          }`}
        >
          {t.nav.tienda}
        </a>

        <a
          href={t.routes.noticias}
          class={`text-sm font-600 tracking-wide transition-colors duration-200 nav-link ${
            matches(t.routes.noticias) ? 'text-cnv-execute' : 'text-cnv-core hover:text-cnv-execute'
          }`}
        >
          {t.nav.noticias}
        </a>

      </div>

      <div class="hidden lg:flex items-center gap-4">
        <a
          href={otherLangHref}
          class="text-xs font-700 tracking-widest text-cnv-core/50 hover:text-cnv-core transition-colors"
        >
          {otherLang}
        </a>
        <a
          href={t.routes.contact}
          class="text-sm font-600 tracking-wide text-cnv-core hover:text-cnv-execute transition-colors"
        >
          {t.nav.contacto}
        </a>

        <!-- INTEGRANTES: botón destacado, con Comentarios colgando de él -->
        <div class="relative group">
          <a
            href={t.routes.integrantes}
            class={`btn-primary text-xs py-2.5 px-5 ${membersActive ? 'ring-2 ring-cnv-execute/30' : ''}`}
          >
            {t.nav.integrantes}
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform duration-200 group-hover:rotate-180">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <div class="absolute top-full right-0 pt-3 hidden group-hover:block focus-within:block">
            <div class="bg-white rounded-xl shadow-xl border border-slate-100/80 py-2 min-w-[210px]">
              {membersLinks.map((link) => (
                <a
                  href={link.href}
                  class={`block px-5 py-2.5 text-sm font-600 tracking-wide transition-colors ${
                    matches(link.href)
                      ? 'text-cnv-execute'
                      : 'text-cnv-core hover:text-cnv-execute hover:bg-slate-50'
                  }`}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <button
        id="menu-toggle"
        class="lg:hidden flex flex-col gap-1.5 p-2"
        aria-label="Toggle menu"
      >
        <span class="menu-line w-6 h-0.5 bg-cnv-core transition-all duration-300 block"></span>
        <span class="menu-line w-6 h-0.5 bg-cnv-core transition-all duration-300 block"></span>
        <span class="menu-line w-4 h-0.5 bg-cnv-core transition-all duration-300 block self-end"></span>
      </button>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden hidden absolute top-full left-0 right-0 bg-white border-t border-slate-100 shadow-xl"
  >
    <div class="max-w-7xl mx-auto px-6 py-8 flex flex-col gap-6">

      <a
        href={t.routes.home}
        class="text-base font-600 text-cnv-core hover:text-cnv-execute transition-colors"
      >
        {t.nav.home}
      </a>

      <a
        href={t.routes.sitemap}
        class="text-base font-600 text-cnv-core hover:text-cnv-execute transition-colors"
      >
        {t.footer.sitemap}
      </a>

      <!-- CNV System -->
      <div class="flex flex-col gap-4">
        <p class="text-xs font-700 uppercase tracking-[0.18em] text-cnv-core/40">
          {t.nav.ecosistema}
        </p>
        <div class="flex flex-col gap-4 pl-4 border-l border-slate-100">
          {ecosystemLinks.map((link) => (
            <a
              href={link.href}
              class="text-base font-600 text-cnv-core hover:text-cnv-execute transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <a
        href={t.routes.store}
        class="text-base font-600 text-cnv-core hover:text-cnv-execute transition-colors"
      >
        {t.nav.tienda}
      </a>

      <a
        href={t.routes.noticias}
        class="text-base font-600 text-cnv-core hover:text-cnv-execute transition-colors"
      >
        {t.nav.noticias}
      </a>

      <a
        href={t.routes.contact}
        class="text-base font-600 text-cnv-core hover:text-cnv-execute transition-colors"
      >
        {t.nav.contacto}
      </a>

      <!-- Integrantes destacado, con Comentarios debajo -->
      <div class="pt-4 border-t border-slate-100 flex flex-col gap-4">
        <a
          href={t.routes.integrantes}
          class="btn-primary text-sm justify-center"
        >
          {t.nav.integrantes}
        </a>
        <a
          href={t.routes.comentarios}
          class="text-sm font-600 text-center text-cnv-core hover:text-cnv-execute transition-colors"
        >
          {t.nav.comentarios}
        </a>
        <a
          href={otherLangHref}
          class="text-xs font-700 tracking-widest text-center text-cnv-core/50"
        >
          {t.nav.switch_lang}
        </a>
      </div>
    </div>
  </div>
</header>

<div class="h-18 lg:h-20"></div>

<script>
  // En Astro, los scripts se ejecutan por componente, es mejor evitar null assertions (!) si la página cambia
  const navbar = document.getElementById('navbar');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (navbar && menuToggle && mobileMenu) {
    
    // 1. Extraemos la lógica a una función reutilizable
    const handleScroll = () => {
      if (window.scrollY > 50) {
        navbar.classList.add('bg-white/95', 'backdrop-blur-sm', 'shadow-sm', 'border-slate-100/80');
      } else {
        navbar.classList.remove('bg-white/95', 'backdrop-blur-sm', 'shadow-sm', 'border-slate-100/80');
      }
    };

    // 2. Ejecutamos la función inmediatamente al cargar la página (¡Esto arregla el bug!)
    handleScroll();

    // 3. Ejecutamos la función cada vez que el usuario haga scroll
    window.addEventListener('scroll', handleScroll);

    // Lógica del menú móvil
    menuToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>