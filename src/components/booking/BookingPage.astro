---
// Página "Agendar valoración en casa" (ES /agendar · EN /en/book).
// Comparte el lenguaje visual de CNV Care (/operacion): Spectral + Inter +
// IBM Plex Mono, navy/teal/dorado. Estilos confinados a .book-root.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingApp from './BookingApp.tsx';
import { getBookingCopy } from './copy';
import { getI18n } from '../../i18n';
import { icon } from '../../lib/icons';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const c = getBookingCopy(lang);
const t = getI18n(lang);
const whatsappPhone = (import.meta.env.PUBLIC_WHATSAPP || t.footer.phone_link || '').replace('+', '');

// ── Arco Cole–Cole del hero (ilustrativo) ───────────────────────────────────
// Semicírculo "deprimido": el centro queda bajo el eje real, como en los datos
// de tejido vivo. Baja frecuencia (Re) a la derecha, alta (R∞) a la izquierda.
const AX = 232; // eje real
const CX = 214, CY = 274, R0 = 70, RE = 358;
const RAD = Math.hypot(RE - CX, AX - CY);
const a0 = Math.atan2(AX - CY, RE - CX); // ángulo en Re
const a1 = Math.atan2(AX - CY, R0 - CX); // ángulo en R∞
const N = 14;
const dots = Array.from({ length: N }, (_, i) => {
  // De Re (baja frecuencia) a R∞ (alta), pasando por el vértice.
  const u = i / (N - 1);
  const th = a0 + (a1 - a0) * u;
  return { x: +(CX + RAD * Math.cos(th)).toFixed(1), y: +(CY + RAD * Math.sin(th)).toFixed(1), d: (0.25 + u * 1.9).toFixed(2) };
});
const arcPath = `M ${RE} ${AX} A ${RAD.toFixed(1)} ${RAD.toFixed(1)} 0 0 0 ${R0} ${AX}`;
const topY = (CY - RAD).toFixed(1);
---

<BaseLayout title={`${c.meta.title} — Connected Nutrition Ventures`} description={c.meta.description}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="book-root">
    <!-- HERO -->
    <header class="bh">
      <div class="wrap bh-grid">
        <div class="bh-copy">
          <div class="kicker">{c.hero.kicker}</div>
          <h1>{c.hero.title}</h1>
          <p>{c.hero.body}</p>
          <div class="bh-ctas">
            <a href="#agendar" class="btn-gold">{c.hero.cta}</a>
            <a href="#recorrido" class="btn-line">{c.hero.cta2}</a>
          </div>
          <ul class="bh-facts">
            {c.hero.facts.map((f) => (
              <li><strong>{f.val}</strong><span>{f.label}</span></li>
            ))}
          </ul>
        </div>

        <figure class="bh-chart" aria-label={c.hero.chart_caption}>
          <svg viewBox="0 0 430 290" role="img">
            <defs>
              <linearGradient id="arcG" x1="1" x2="0" y1="0" y2="0">
                <stop offset="0" stop-color="#C9A961" />
                <stop offset="1" stop-color="#3FC1B0" />
              </linearGradient>
              <radialGradient id="glow">
                <stop offset="0" stop-color="#fff" stop-opacity="1" />
                <stop offset=".4" stop-color="#3FC1B0" stop-opacity=".8" />
                <stop offset="1" stop-color="#3FC1B0" stop-opacity="0" />
              </radialGradient>
            </defs>
            <!-- rejilla -->
            {[0, 1, 2, 3, 4].map((i) => (
              <line x1="40" x2="400" y1={AX - i * 40} y2={AX - i * 40} class="grid" />
            ))}
            <line x1="40" x2="404" y1={AX} y2={AX} class="axis" />
            <line x1="40" x2="40" y1="60" y2={AX} class="axis" />
            <text x="404" y={AX + 42} class="ax-l" text-anchor="end">R (Ω)</text>
            <text x="46" y="56" class="ax-l">−X (Ω)</text>
            <!-- arco -->
            <path d={arcPath} class="arc" pathLength="1" id="cc-arc" />
            {dots.map((p) => (
              <circle cx={p.x} cy={p.y} r="4.2" class="dot" style={`animation-delay:${p.d}s`} />
            ))}
            <!-- vértice: frecuencia característica -->
            <line x1={CX} x2={CX} y1={topY} y2={AX} class="guide" />
            <text x={CX} y={+topY - 12} class="lbl" text-anchor="middle">fc</text>
            <!-- extremos -->
            <circle cx={RE} cy={AX} r="5" class="end" />
            <circle cx={R0} cy={AX} r="5" class="end" />
            <text x={RE} y={AX + 22} class="lbl" text-anchor="middle">Re</text>
            <text x={R0} y={AX + 22} class="lbl" text-anchor="middle">R∞</text>
            <text x={RE + 4} y={AX - 14} class="freq" text-anchor="middle">1 kHz</text>
            <text x={R0 - 2} y={AX - 14} class="freq" text-anchor="middle">1 MHz</text>
            <!-- pulso que recorre el espectro -->
            <circle r="11" fill="url(#glow)" class="pulse" opacity="0">
                <set attributeName="opacity" to="1" begin="2.6s" />
              <animateMotion dur="4.5s" begin="2.6s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear">
                <mpath href="#cc-arc" />
              </animateMotion>
            </circle>
          </svg>
          <figcaption>
            <span>{c.hero.chart_caption}</span>
            <small>{c.hero.chart_note}</small>
          </figcaption>
        </figure>
      </div>
    </header>

    <!-- RECORRIDO -->
    <section class="sec" id="recorrido">
      <div class="wrap">
        <div class="kicker">{c.journey.kicker}</div>
        <h2>{c.journey.title}</h2>
        <p class="lead">{c.journey.lead}</p>
        <ol class="journey">
          {c.journey.steps.map((s, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <span class="j-n">0{i + 1}</span>
              <span class="j-tag">{s.tag}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- QUÉ MEDIMOS -->
    <section class="sec sec-soft">
      <div class="wrap">
        <div class="kicker">{c.measures.kicker}</div>
        <h2>{c.measures.title}</h2>
        <div class="measures">
          {c.measures.items.map((m, i) => (
            <article class="m-card reveal" style={`--i:${i}`}>
              <span class="m-ico" set:html={icon(m.icon, 28)} />
              <h3>{m.title}</h3>
              <p>{m.body}</p>
              <div class="chips">{m.chips.map((x) => <span>{x}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- POR QUÉ EN CASA -->
    <section class="sec">
      <div class="wrap why">
        <div>
          <div class="kicker">{c.why.kicker}</div>
          <h2>{c.why.title}</h2>
          <p class="lead">{c.why.body}</p>
        </div>
        <div class="cmp-wrap reveal">
          <table class="cmp">
            <thead>
              <tr>{c.why.compare_head.map((h, i) => <th class={i === 2 ? 'hi' : ''}>{h}</th>)}</tr>
            </thead>
            <tbody>
              {c.why.compare_rows.map((r) => (
                <tr>
                  <th scope="row">{r[0]}</th>
                  <td>{r[1]}</td>
                  <td class="hi"><span set:html={icon('check', 15)} />{r[2]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- AGENDA -->
    <section class="sec sec-navy" id="agendar">
      <div class="wrap">
        <div class="kicker">{c.form.kicker}</div>
        <h2>{c.form.title}</h2>
        <p class="lead">{c.form.lead}</p>
        <div class="bk-mount">
          <BookingApp client:visible t={c.form} lang={lang} whatsappPhone={whatsappPhone} />
        </div>
      </div>
    </section>

    <!-- PREPARACIÓN -->
    <section class="sec">
      <div class="wrap">
        <div class="kicker">{c.prep.kicker}</div>
        <h2>{c.prep.title}</h2>
        <p class="lead">{c.prep.lead}</p>
        <div class="prep">
          {c.prep.items.map((p, i) => (
            <div class="p-item reveal" style={`--i:${i % 3}`}>
              <span class="p-ico" set:html={icon(p.icon, 22)} />
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec sec-soft">
      <div class="wrap faq-wrap">
        <div>
          <div class="kicker">{c.faq.kicker}</div>
          <h2>{c.faq.title}</h2>
          <a href="#agendar" class="btn-navy">{c.hero.cta}</a>
        </div>
        <div class="faq">
          {c.faq.items.map((q) => (
            <details>
              <summary>{q.q}</summary>
              <p>{q.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    // Entrada suave de tarjetas al hacer scroll.
    const els = document.querySelectorAll('.book-root .reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.15 },
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('in'));
    }
  </script>

  <style is:global>
    .book-root{
      --navy:#16324F;--navy2:#0f2640;--teal:#147F76;--teal2:#3FC1B0;--gold:#C9A961;
      --ink:#1A2B3C;--muted:#5B6B7A;--bg:#fff;--soft:#F6F4EF;--line:#E4DECF;
      --display:'Spectral',Georgia,serif;--body:'Inter',system-ui,sans-serif;--mono:'IBM Plex Mono',monospace;
      font-family:var(--body);color:var(--ink);background:var(--bg);line-height:1.6;-webkit-font-smoothing:antialiased;
    }
    .book-root *{box-sizing:border-box}
    .book-root .wrap{max-width:1160px;margin:0 auto;padding:0 24px}
    .book-root h2{font-family:var(--display);font-weight:700;font-size:clamp(28px,4vw,44px);color:var(--navy);line-height:1.1;margin:14px 0 0}
    .book-root .lead{font-size:18px;color:var(--muted);max-width:660px;margin-top:16px}
    .book-root .kicker{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold)}
    .book-root .kicker::before{content:"";display:inline-block;width:26px;height:1px;background:var(--gold);vertical-align:middle;margin-right:10px;transform:translateY(-3px)}
    .book-root .sec{padding:96px 0}
    .book-root .sec-soft{background:var(--soft)}
    .book-root .sec-navy{background:var(--navy);color:#fff}
    .book-root .sec-navy h2{color:#fff}
    .book-root .sec-navy .lead{color:#cfdae6}

    /* Botones */
    .book-root .btn-gold,.book-root .btn-line,.book-root .btn-navy{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;padding:14px 26px;border-radius:999px;transition:transform .2s,background .2s,color .2s;text-decoration:none}
    .book-root .btn-gold{background:var(--gold);color:var(--navy2)}
    .book-root .btn-gold:hover{transform:translateY(-2px);background:#d8b973}
    .book-root .btn-line{border:1px solid rgba(255,255,255,.35);color:#fff}
    .book-root .btn-line:hover{border-color:#fff}
    .book-root .btn-navy{background:var(--navy);color:#fff;margin-top:28px}
    .book-root .btn-navy:hover{background:var(--teal)}

    /* HERO */
    .book-root .bh{background:radial-gradient(1200px 500px at 85% 10%,#1f4a6e 0%,transparent 60%),var(--navy);color:#fff;padding:120px 0 90px;overflow:hidden}
    .book-root .bh-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
    @media(max-width:920px){.book-root .bh-grid{grid-template-columns:1fr}.book-root .bh{padding:104px 0 64px}}
    .book-root .bh h1{font-family:var(--display);font-weight:700;font-size:clamp(34px,5.2vw,60px);line-height:1.05;margin:18px 0 0}
    .book-root .bh-copy>p{font-size:clamp(16px,1.8vw,19px);color:#cfdae6;margin-top:22px;max-width:580px}
    .book-root .bh-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
    .book-root .bh-facts{display:flex;flex-wrap:wrap;gap:32px;margin:44px 0 0;padding:0;list-style:none}
    .book-root .bh-facts li{display:flex;flex-direction:column}
    .book-root .bh-facts strong{font-family:var(--mono);font-size:28px;color:var(--gold);line-height:1}
    .book-root .bh-facts span{font-size:13px;color:#9fb3c8;margin-top:6px}

    .book-root .bh-chart{margin:0;background:linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:18px 18px 14px}
    .book-root .bh-chart svg{width:100%;height:auto;display:block}
    .book-root .bh-chart .grid{stroke:rgba(255,255,255,.06)}
    .book-root .bh-chart .axis{stroke:rgba(255,255,255,.35);stroke-width:1}
    .book-root .bh-chart .guide{stroke:rgba(201,169,97,.5);stroke-dasharray:3 4}
    .book-root .bh-chart .ax-l{fill:#9fb3c8;font:500 11px var(--mono)}
    .book-root .bh-chart .lbl{fill:#fff;font:600 13px var(--mono)}
    .book-root .bh-chart .freq{fill:var(--gold);font:500 10px var(--mono)}
    .book-root .bh-chart .arc{fill:none;stroke:url(#arcG);stroke-width:2.5;stroke-dasharray:1;stroke-dashoffset:1;animation:bk-draw 2.4s .2s cubic-bezier(.6,.1,.3,1) forwards}
    .book-root .bh-chart .dot{fill:#fff;opacity:0;animation:bk-pop .5s ease-out forwards}
    .book-root .bh-chart .end{fill:var(--navy);stroke:var(--gold);stroke-width:2}
    .book-root .bh-chart figcaption{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:8px;font-size:13px;color:#cfdae6}
    .book-root .bh-chart figcaption small{font-family:var(--mono);font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#7f95ab}
    @keyframes bk-draw{to{stroke-dashoffset:0}}
    @keyframes bk-pop{0%{opacity:0;transform:scale(.2)}70%{opacity:1;transform:scale(1.3)}100%{opacity:.9;transform:scale(1)}}
    .book-root .bh-chart .dot{transform-box:fill-box;transform-origin:center}

    /* RECORRIDO */
    .book-root .journey{list-style:none;padding:0;margin:56px 0 0;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;position:relative}
    .book-root .journey::before{content:"";position:absolute;top:26px;left:4%;right:4%;height:2px;background:linear-gradient(90deg,var(--gold),var(--teal));opacity:.5}
    @media(max-width:900px){.book-root .journey{grid-template-columns:1fr 1fr}.book-root .journey::before{display:none}}
    @media(max-width:560px){.book-root .journey{grid-template-columns:1fr}}
    .book-root .journey li{position:relative;background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px 24px 26px}
    .book-root .j-n{position:absolute;top:-1px;left:24px;transform:translateY(-50%);background:var(--navy);color:var(--gold);font:600 14px var(--mono);padding:6px 12px;border-radius:999px}
    .book-root .j-tag{display:block;margin-top:14px;font:600 11px var(--mono);letter-spacing:2px;text-transform:uppercase;color:var(--teal)}
    .book-root .journey h3{font-family:var(--display);font-size:22px;color:var(--navy);margin:6px 0 8px}
    .book-root .journey p{font-size:15px;color:var(--muted);margin:0}

    /* QUÉ MEDIMOS */
    .book-root .measures{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:48px}
    @media(max-width:900px){.book-root .measures{grid-template-columns:1fr}}
    .book-root .m-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px}
    .book-root .m-ico{display:inline-flex;width:52px;height:52px;border-radius:14px;background:rgba(20,127,118,.1);color:var(--teal);align-items:center;justify-content:center}
    .book-root .m-card h3{font-family:var(--display);font-size:21px;color:var(--navy);margin:18px 0 8px}
    .book-root .m-card p{font-size:15px;color:var(--muted);margin:0}
    .book-root .chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:18px}
    .book-root .chips span{font:600 11px var(--mono);color:var(--navy);background:var(--soft);border:1px solid var(--line);padding:4px 10px;border-radius:999px}

    /* POR QUÉ */
    .book-root .why{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:center}
    @media(max-width:900px){.book-root .why{grid-template-columns:1fr;gap:32px}}
    .book-root .cmp-wrap{overflow-x:auto;border-radius:16px;border:1px solid var(--line)}
    .book-root .cmp{width:100%;border-collapse:collapse;font-size:15px;min-width:460px}
    .book-root .cmp th,.book-root .cmp td{padding:16px 18px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
    .book-root .cmp thead th{font:600 11px var(--mono);letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);background:var(--soft)}
    .book-root .cmp tbody th{font-weight:600;color:var(--navy)}
    .book-root .cmp td{color:var(--muted)}
    .book-root .cmp .hi{background:rgba(20,127,118,.06);color:var(--navy);font-weight:600}
    .book-root .cmp thead .hi{background:var(--teal);color:#fff}
    .book-root .cmp td.hi span{color:var(--teal);display:inline-flex;vertical-align:-2px;margin-right:6px}
    .book-root .cmp tr:last-child>*{border-bottom:none}

    /* PREPARACIÓN */
    .book-root .prep{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}
    @media(max-width:900px){.book-root .prep{grid-template-columns:1fr 1fr}}
    @media(max-width:560px){.book-root .prep{grid-template-columns:1fr}}
    .book-root .p-item{display:flex;gap:16px;padding:22px;border:1px solid var(--line);border-radius:14px}
    .book-root .p-ico{flex:0 0 auto;color:var(--teal);line-height:0;margin-top:2px}
    .book-root .p-item h3{font-family:var(--display);font-size:18px;color:var(--navy);margin:0 0 4px}
    .book-root .p-item p{font-size:14.5px;color:var(--muted);margin:0}

    /* FAQ */
    .book-root .faq-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px}
    @media(max-width:900px){.book-root .faq-wrap{grid-template-columns:1fr;gap:28px}}
    .book-root .faq details{background:#fff;border:1px solid var(--line);border-radius:14px;margin-bottom:12px;padding:0 22px}
    .book-root .faq summary{cursor:pointer;list-style:none;padding:20px 28px 20px 0;font-weight:600;color:var(--navy);position:relative}
    .book-root .faq summary::-webkit-details-marker{display:none}
    .book-root .faq summary::after{content:"+";position:absolute;right:0;top:16px;font:500 22px var(--mono);color:var(--teal);transition:transform .2s}
    .book-root .faq details[open] summary::after{transform:rotate(45deg)}
    .book-root .faq details p{margin:0 0 20px;color:var(--muted);font-size:15px}

    /* Entrada al hacer scroll */
    .book-root .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease;transition-delay:calc(var(--i,0) * 90ms)}
    .book-root .reveal.in{opacity:1;transform:none}

    /* ═══ ASISTENTE (isla React BookingApp) ═══ */
    .book-root .bk-mount{margin-top:44px;min-height:520px}
    .book-root .bk-grid{display:grid;grid-template-columns:1fr 340px;gap:28px;align-items:start}
    @media(max-width:960px){.book-root .bk-grid{grid-template-columns:1fr}.book-root .bk-ticket{order:-1}}
    .book-root .bk-panel{background:#fff;color:var(--ink);border-radius:20px;padding:30px;box-shadow:0 30px 60px -30px rgba(0,0,0,.5)}
    @media(max-width:560px){.book-root .bk-panel{padding:22px 18px}}
    .book-root .bk-steps{list-style:none;margin:0 0 26px;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
    .book-root .bk-steps button{all:unset;cursor:pointer;display:flex;align-items:center;gap:10px;width:100%;padding-bottom:12px;border-bottom:3px solid var(--line)}
    .book-root .bk-steps button:disabled{cursor:default}
    .book-root .bk-step-n{flex:0 0 auto;width:28px;height:28px;border-radius:50%;display:grid;place-items:center;font:600 13px var(--mono);background:var(--soft);color:var(--muted)}
    .book-root .bk-step-l{font-size:13px;font-weight:600;color:var(--muted)}
    .book-root .bk-steps li.on button{border-color:var(--teal)}
    .book-root .bk-steps li.on .bk-step-n{background:var(--teal);color:#fff}
    .book-root .bk-steps li.on .bk-step-l{color:var(--navy)}
    .book-root .bk-steps li.ok button{border-color:var(--gold)}
    .book-root .bk-steps li.ok .bk-step-n{background:var(--gold);color:var(--navy2)}
    @media(max-width:560px){.book-root .bk-step-l{display:none}.book-root .bk-steps li.on .bk-step-l{display:inline}}
    .book-root .bk-body{animation:bk-in .35s ease}
    @keyframes bk-in{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}
    .book-root .bk-h{font-family:var(--display);font-size:24px;color:var(--navy);margin:0 0 14px}
    .book-root .bk-muted{color:var(--muted);font-size:15px;margin:0 0 16px}
    .book-root .bk-note{font-size:13px;color:var(--muted);background:var(--soft);border-left:3px solid var(--gold);padding:10px 14px;border-radius:0 8px 8px 0;margin:6px 0 0}
    .book-root .bk-label{font-weight:600;font-size:14px;color:var(--navy);margin:20px 0 10px}
    .book-root .bk-label small{font-weight:500;color:var(--muted)}

    .book-root .bk-services{display:grid;gap:12px}
    .book-root .bk-service{position:relative;display:block;cursor:pointer;border:2px solid var(--line);border-radius:14px;padding:18px 20px;transition:border-color .2s,box-shadow .2s,background .2s}
    .book-root .bk-service:hover{border-color:#c9d6d4}
    .book-root .bk-service.on{border-color:var(--teal);background:rgba(20,127,118,.04);box-shadow:0 0 0 4px rgba(20,127,118,.1)}
    .book-root .bk-service input{position:absolute;opacity:0;pointer-events:none}
    .book-root .bk-service-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .book-root .bk-service-title{font-family:var(--display);font-size:20px;font-weight:700;color:var(--navy)}
    .book-root .bk-badge{font:600 10px var(--mono);letter-spacing:1px;text-transform:uppercase;background:var(--gold);color:var(--navy2);padding:3px 9px;border-radius:999px}
    .book-root .bk-service-body{display:block;font-size:14.5px;color:var(--muted);margin-top:4px}
    .book-root .bk-service-incl{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
    .book-root .bk-service-incl span{font:600 11px var(--mono);color:var(--teal);background:rgba(20,127,118,.08);padding:3px 9px;border-radius:999px}

    .book-root .bk-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .book-root .bk-row-doc{grid-template-columns:.7fr 1.3fr}
    @media(max-width:560px){.book-root .bk-row,.book-root .bk-row-doc{grid-template-columns:1fr}}
    .book-root .bk-field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
    .book-root .bk-field>span{font-size:13px;font-weight:600;color:var(--navy)}
    .book-root .bk-field input,.book-root .bk-field select,.book-root .bk-field textarea{font:inherit;font-size:15px;color:var(--ink);background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;outline:none;transition:border-color .2s,box-shadow .2s;width:100%}
    .book-root .bk-field textarea{resize:vertical}
    .book-root .bk-field input:focus,.book-root .bk-field select:focus,.book-root .bk-field textarea:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(20,127,118,.15)}
    .book-root .bk-field [aria-invalid="true"]{border-color:#c2410c}
    .book-root .bk-hint{font-size:12px;color:var(--muted)}
    .book-root .bk-err{font-size:12px;font-weight:600;color:#c2410c;display:block;margin-top:2px}

    .book-root .bk-cal{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
    .book-root .bk-cal-wd{font:600 11px var(--mono);text-transform:uppercase;color:var(--muted);text-align:center;padding:4px 0}
    .book-root .bk-day{all:unset;cursor:pointer;position:relative;aspect-ratio:1/1;max-height:54px;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:10px;font:600 15px var(--body);color:var(--navy);background:var(--soft);transition:background .15s,color .15s,transform .15s}
    .book-root .bk-day small{font:600 9px var(--mono);text-transform:uppercase;color:var(--gold);line-height:1}
    .book-root .bk-day:hover:not(:disabled){background:rgba(20,127,118,.12)}
    .book-root .bk-day:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
    .book-root .bk-day:disabled{cursor:default;background:transparent;color:#c3cbd3;font-weight:500}
    .book-root .bk-day.on{background:var(--teal);color:#fff;transform:scale(1.04)}
    .book-root .bk-day.on small{color:#e8fffb}

    .book-root .bk-slots{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:6px}
    .book-root .bk-slot{all:unset;cursor:pointer;display:flex;flex-direction:column;gap:2px;padding:14px 16px;border:2px solid var(--line);border-radius:12px;transition:border-color .2s,background .2s}
    .book-root .bk-slot strong{color:var(--navy);font-size:15px}
    .book-root .bk-slot span{font:500 12px var(--mono);color:var(--muted)}
    .book-root .bk-slot em{font-style:normal;font:600 10px var(--mono);letter-spacing:1px;text-transform:uppercase;color:var(--gold);margin-top:4px}
    .book-root .bk-slot:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
    .book-root .bk-slot.on{border-color:var(--teal);background:rgba(20,127,118,.05)}
    .book-root .bk-slots+.bk-err{margin-bottom:10px}
    .book-root .bk-slots~.bk-field{margin-top:18px}

    .book-root .bk-consent{display:flex;gap:12px;align-items:flex-start;font-size:13px;color:var(--muted);line-height:1.55;cursor:pointer;margin-top:4px}
    .book-root .bk-consent input{margin-top:3px;width:18px;height:18px;accent-color:var(--teal);flex:0 0 auto}
    .book-root .bk-consent a{color:var(--teal);font-weight:600}
    .book-root .bk-consent.is-err{color:#c2410c}
    .book-root .bk-turnstile{margin-top:16px}
    .book-root .bk-alert{margin:14px 0 0;font-size:14px;font-weight:600;color:#9a3412;background:#fff7ed;border-left:3px solid #c2410c;padding:10px 14px;border-radius:0 8px 8px 0}

    .book-root .bk-nav{display:flex;justify-content:space-between;align-items:center;margin-top:26px;padding-top:20px;border-top:1px solid var(--line)}
    .book-root .bk-btn{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:8px;background:var(--navy);color:#fff;font-weight:600;font-size:15px;padding:13px 24px;border-radius:999px;transition:background .2s,transform .2s}
    .book-root .bk-btn:hover{background:var(--teal);transform:translateY(-1px)}
    .book-root .bk-btn:disabled{opacity:.6;cursor:wait}
    .book-root .bk-btn:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
    .book-root .bk-btn-ghost{background:transparent;color:var(--navy);box-shadow:inset 0 0 0 1.5px var(--navy)}
    .book-root .bk-btn-ghost:hover{background:var(--navy);color:#fff}
    .book-root .bk-link{all:unset;cursor:pointer;font-weight:600;font-size:14px;color:var(--muted)}
    .book-root .bk-link:hover{color:var(--navy)}

    /* Tarjeta resumen */
    .book-root .bk-ticket{position:sticky;top:110px;background:linear-gradient(160deg,#1d4466,#122a44);border:1px solid rgba(255,255,255,.12);border-radius:20px;color:#fff;overflow:hidden}
    .book-root .bk-ticket-top{padding:22px 24px 6px;display:flex;flex-direction:column;gap:4px}
    .book-root .bk-ticket-brand{font:600 10px var(--mono);letter-spacing:3px;text-transform:uppercase;color:var(--gold)}
    .book-root .bk-ticket-title{font-family:var(--display);font-size:24px;font-weight:700}
    .book-root .bk-ticket-rows{margin:0;padding:8px 24px 18px}
    .book-root .bk-ticket-rows>div{padding:12px 0;border-bottom:1px dashed rgba(255,255,255,.14)}
    .book-root .bk-ticket-rows>div:last-child{border-bottom:none}
    .book-root .bk-ticket-rows dt{font:600 10px var(--mono);letter-spacing:1.5px;text-transform:uppercase;color:#8ea6be}
    .book-root .bk-ticket-rows dd{margin:3px 0 0;font-weight:600;font-size:15px;display:flex;flex-direction:column}
    .book-root .bk-ticket-rows dd small{font:500 12px var(--mono);color:var(--teal2);margin-top:2px}
    .book-root .bk-ticket-rows dd.is-pending{color:#6f88a1;font-weight:500;font-style:italic}
    .book-root .bk-cap::first-letter{text-transform:uppercase}
    .book-root .bk-ticket-tear{position:relative;height:0;border-top:2px dashed rgba(255,255,255,.18);margin:0 18px}
    .book-root .bk-ticket-tear::before,.book-root .bk-ticket-tear::after{content:"";position:absolute;top:-13px;width:24px;height:24px;border-radius:50%;background:var(--navy)}
    .book-root .bk-ticket-tear::before{left:-31px}
    .book-root .bk-ticket-tear::after{right:-31px}
    .book-root .bk-ticket-foot{padding:18px 24px 22px;display:flex;flex-direction:column;gap:14px}
    .book-root .bk-ticket-label{display:block;font:600 10px var(--mono);letter-spacing:1.5px;text-transform:uppercase;color:#8ea6be}
    .book-root .bk-ticket-code{font:600 24px var(--mono);letter-spacing:2px;color:var(--gold)}
    .book-root .bk-ticket-incl{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px 14px;font-size:13px;color:#cfdae6}
    .book-root .bk-ticket-incl li{display:inline-flex;align-items:center;gap:5px}
    .book-root .bk-ticket-incl span{color:var(--teal2);line-height:0}
    .book-root .bk-ticket.is-done{box-shadow:0 0 0 2px var(--gold),0 20px 50px -20px rgba(201,169,97,.5)}

    /* Confirmación */
    .book-root .bk-done{text-align:left}
    .book-root .bk-done-mark{width:64px;height:64px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center;animation:bk-pop .6s ease-out}
    .book-root .bk-done .bk-kicker{font:600 11px var(--mono);letter-spacing:2px;text-transform:uppercase;color:var(--teal);margin:22px 0 0}
    .book-root .bk-done h3{font-family:var(--display);font-size:clamp(24px,3vw,32px);color:var(--navy);margin:6px 0 10px;line-height:1.15}
    .book-root .bk-sub{font-weight:600;color:var(--navy);margin:24px 0 10px}
    .book-root .bk-next{list-style:none;margin:0;padding:0;display:grid;gap:10px}
    .book-root .bk-next li{display:flex;gap:12px;align-items:flex-start;font-size:15px;color:var(--muted)}
    .book-root .bk-next li span{flex:0 0 auto;width:26px;height:26px;border-radius:50%;background:var(--soft);color:var(--navy);font:600 12px var(--mono);display:grid;place-items:center}
    .book-root .bk-actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-top:28px}

    @media (prefers-reduced-motion: reduce){
      .book-root .bh-chart .arc{animation:none;stroke-dashoffset:0}
      .book-root .bh-chart .dot{animation:none;opacity:.9}
      .book-root .bh-chart .pulse{display:none}
      .book-root .reveal{opacity:1;transform:none;transition:none}
      .book-root .bk-body,.book-root .bk-done-mark{animation:none}
    }
  </style>
</BaseLayout>
