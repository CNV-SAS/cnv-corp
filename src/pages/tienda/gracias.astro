---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getI18n } from '../../i18n';
import { icon } from '../../lib/icons';

const lang = Astro.currentLocale || 'es';
const t = getI18n(lang);
const s = t.store;
---

<BaseLayout title={`${s.thanks_title} — CNV`} description={s.thanks_body}>
  <section class="max-w-2xl mx-auto px-6 py-32 text-center">
    <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-cnv-generate/10 text-cnv-generate" set:html={icon('check', 28)} />
    <h1 class="text-3xl md:text-4xl font-800 text-cnv-core">{s.thanks_title}</h1>
    <p class="mt-5 text-base text-cnv-core/60 leading-relaxed">{s.thanks_body}</p>
    <a href={t.routes.store} class="btn-primary mt-10 inline-flex">{s.thanks_back}</a>
  </section>
  <script is:inline>
    // Vaciamos el carrito al llegar a la página de gracias.
    try { localStorage.removeItem('cnv_cart_v1'); } catch (e) {}
  </script>
</BaseLayout>
