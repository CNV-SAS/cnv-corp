# Resend API Key — get it at https://resend.com
# IMPORTANTE: verifica el dominio cnvsystem.com en Resend antes de usar
# El FROM será cnvcorporate@gmail.com — el TO puede ser cualquier email incluido Gmail
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email de destino de las solicitudes del formulario
CONTACT_EMAIL=cnvcorporate@gmail.com

# ─────────────────────────────────────────────────────────────
# COMENTARIOS — Supabase (proyecto de la WEB, no el de ATLAS)
# ─────────────────────────────────────────────────────────────
# Ejecuta primero supabase/comentarios.sql en el SQL Editor del proyecto.
# Las claves están en Supabase → Project Settings → API.
#
# Sin estas variables la página de comentarios sigue funcionando: muestra los
# comentarios base y el formulario envía por correo, pero no se publica nada.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon / public key — sólo puede leer la vista comentarios_publicos
PUBLIC_SUPABASE_ANON_KEY=eyJhb...
# service_role key — NUNCA la expongas ni la subas al repo. Sólo servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhb...

# ─────────────────────────────────────────────────────────────
# TIENDA — Pasarela de pagos
# ─────────────────────────────────────────────────────────────
# WOMPI (Colombia: Bre-B, tarjetas, PSE, Nequi, Bancolombia)
# Obtén las llaves en https://comercios.wompi.co → Desarrolladores
# La PÚBLICA (pub_) puede exponerse; el SECRETO DE INTEGRIDAD nunca se expone.
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxx

# PAYPAL (pagos internacionales, cobro en USD). Opcional.
# Client ID de tu app en https://developer.paypal.com/dashboard
# Debe llevar el prefijo PUBLIC_ para poder usarse en el navegador.
PUBLIC_PAYPAL_CLIENT_ID=

# Tasa COP→USD usada SÓLO para mostrar/cobrar en PayPal (aprox.)
PUBLIC_USD_RATE=4200

# Teléfono de WhatsApp para pedidos (formato wa.me, sin "+"). Opcional:
# si se deja vacío se usa el teléfono del footer.
PUBLIC_WHATSAPP=573216428280

# URL pública del sitio (para la redirección de retorno de Wompi)
PUBLIC_SITE_URL=https://cnvsystem.com
